[
{"scene": "c1", "who": "hana", "text": "김하나입니다. 아버지 일 때문에 왔어요.", "face": "normal"},
{"scene": "c1", "who": "hana", "text": "…딱히 없어요.", "face": "normal"},
{"scene": "c1", "who": "hana", "text": "응.", "face": "normal"},
{"scene": "c1", "who": "hana", "text": "응.", "face": "normal"},
{"scene": "c1", "who": "hana", "text": "…응. 고마워.", "face": "flustered"},
{"scene": "c1", "who": "hana", "text": "…아니. 이거밖에 안 남았대. 학기 중간이라.", "face": "normal"},
{"scene": "c1_lab", "who": "hana", "text": "…진자 길이 재는 거, 내가 할게. 너 각도 봐 줘. 10도 넘으면 안 돼.", "face": "focused"},
{"scene": "c1_lab", "who": "hana", "text": "각도가 크면 주기가 길이만으로 안 정해져. 근사가 깨져. 선생님이 말한 이유가 그거야.", "face": "focused"},
{"scene": "c1_lab", "who": "hana", "text": "…아버지가 해군이야. 숫자 틀리면 배가 엉뚱한 데로 간대. 어릴 때부터 그 말 듣고 자랐어.", "face": "normal"},
{"scene": "c1_lab", "who": "hana", "text": "물리는 어디 가도 똑같아서 좋아. 학교가 바뀌어도 진자는 똑같이 흔들리니까.", "face": "happy"},
{"scene": "c1_lab", "who": "hana", "text": "…좀.", "face": "flustered"},
{"scene": "c1_lab", "who": "hana", "text": "…그런가.", "face": "normal"},
{"scene": "c1_lab", "who": "hana", "text": "…네.", "face": "normal"},
{"scene": "c1_vocalo", "who": "hana", "text": "…알아? 이거 조회수 별로 안 높은데.", "face": "flustered"},
{"scene": "c1_vocalo", "who": "hana", "text": "…나도.", "face": "happy"},
{"scene": "c1_vocalo", "who": "hana", "text": "…2절이 더 좋아. 여기서 베이스 들어오는 데.", "face": "happy"},
{"scene": "c1_vocalo", "who": "hana", "text": "이사 다니면 친구는 못 데려가는데, 노래는 같이 이사 와. 그래서 좋아해.", "face": "normal"},
{"scene": "c1_vocalo", "who": "hana", "text": "…이상한 말 했다. 잊어.", "face": "flustered"},
{"scene": "c1_vocalo", "who": "hana", "text": "…그럼 비밀로 해.", "face": "pout"},
{"scene": "c1_bad", "who": "hana", "text": "…응. 괜찮아. 익숙해.", "face": "crying"},
{"scene": "c1_after", "who": "hana", "text": "아.", "face": "flustered"},
{"scene": "c1_after", "who": "hana", "text": "…이거 마시는 사람 처음 봤다는 얼굴 하지 마. 맛있어.", "face": "pout"},
{"scene": "c1_after", "who": "hana", "text": "체리 맛이야. 정정해.", "face": "pout"},
{"scene": "c1_after", "who": "hana", "text": "이 자판기, 이 동네에서 닥터페퍼 파는 유일한 자판기야. 이사 오고 사흘 동안 찾았어.", "face": "normal"},
{"scene": "c1_after", "who": "hana", "text": "새 동네 가면 제일 먼저 하는 일이야. 닥터페퍼 자판기 찾기랑, 서점 찾기랑, 오락실 찾기.", "face": "happy"},
{"scene": "c1_after", "who": "hana", "text": "…친구 찾기는 순서에 없어.", "face": "normal"},
{"scene": "c1_after", "who": "hana", "text": "이 동네, 바다 냄새 안 나서 좋다. …아니, 좋은 건지 모르겠다.", "face": "normal"},
{"scene": "c1_after", "who": "hana", "text": "어차피 여기도 2년이니까.", "face": "normal"},
{"scene": "i1", "who": "father", "text": "하나. 밥.", "face": "normal"},
{"scene": "i1", "who": "hana", "text": "응.", "face": "normal"},
{"scene": "i1", "who": "father", "text": "학교는.", "face": "normal"},
{"scene": "i1", "who": "hana", "text": "괜찮아.", "face": "normal"},
{"scene": "i1", "who": "father", "text": "…그래.", "face": "normal"},
{"scene": "i1", "who": "hana", "text": "…아빠. 오늘, 그 노래 아는 애가 있었어.", "face": "happy"},
{"scene": "i1", "who": "father", "text": "그 시끄러운 노래.", "face": "normal"},
{"scene": "i1", "who": "hana", "text": "시끄럽지 않아.", "face": "pout"},
{"scene": "i1", "who": "father", "text": "…잘됐구나.", "face": "relief"},
{"scene": "c2", "who": "hana", "text": "…해. 조금.", "face": "flustered"},
{"scene": "c2", "who": "hana", "text": "…조금.", "face": "normal"},
{"scene": "c2", "who": "hana", "text": "이 곡은 3년 했어. 이사 갈 때마다 기차에서 했으니까. 진해에서 여기까지 네 시간 반이야.", "face": "focused"},
{"scene": "c2", "who": "hana", "text": "싫어.", "face": "pout"},
{"scene": "c2_popular", "who": "hana", "text": "…선생님이 불렀다는 거, 거짓말이지.", "face": "normal"},
{"scene": "c2_popular", "who": "hana", "text": "…고마워. 저런 거, 어떻게 거절해야 할지 몰라서.", "face": "flustered"},
{"scene": "c2_popular", "who": "hana", "text": "거절하면 그다음이 귀찮아지고, 안 하면 더 귀찮아져. 그래서 전 학교에서는 그냥 아무하고도 말 안 했어. 그게 제일 조용하니까", "face": "normal"},
{"scene": "c2_popular", "who": "hana", "text": "…그러게. 실수했나.", "face": "normal"},
{"scene": "c2_rain", "who": "hana", "text": "진해요. 그 전엔 평택, 그 전엔 목포, 그 전엔…", "face": "normal"},
{"scene": "c2_rain", "who": "hana", "text": "…저도요.", "face": "normal"},
{"scene": "c2_rain", "who": "hana", "text": "…일곱 번. 여기가 여덟 번째.", "face": "normal"},
{"scene": "c2_rain", "who": "hana", "text": "세는 거, 좀 그만둘까 생각 중이야.", "face": "normal"},
{"scene": "c2_rain", "who": "hana", "text": "…신기하다. 그런 사람 처음 봐. 아니, 많이 봤는데 물어본 건 처음이야.", "face": "happy"},
{"scene": "c2_study", "who": "hana", "text": "…리듬게임으로 생각해 봐. 노트 두 개가 부딪쳐도 콤보 수 합은 안 바뀌어.", "face": "focused"},
{"scene": "c2_study", "who": "hana", "text": "그럼 탄성 충돌은, 퍼펙트끼리 부딪친 거. 비탄성 충돌은 그레이트.", "face": "focused"},
{"scene": "c2_study", "who": "hana", "text": "…응. 혼자 하면 집중 안 될 때 있어. 집이 아직 박스 반이라.", "face": "happy"},
{"scene": "c2_craft", "who": "hana", "text": "(채팅) 화로 같이 써도 돼. 지붕은 내가 할 거야. 손대지 마.", "face": "pout"},
{"scene": "c2_craft", "who": "hana", "text": "(채팅) 그리고 \"임시\" 표지판도 건드리지 마.", "face": "pout"},
{"scene": "c2_craft", "who": "hana", "text": "(채팅) …서버 들어갈 때마다 그렇게 지어. 습관.", "face": "normal"},
{"scene": "c2_craft", "who": "hana", "text": "(채팅) 이 서버 좋다. 이사 가도 서버는 안 없어지니까.", "face": "happy"},
{"scene": "c2_ask", "who": "hana", "text": "…봤어? 지붕 아직 안 지었는데.", "face": "flustered"},
{"scene": "c2_ask", "who": "hana", "text": "다음에 들어오면 귓속말 해. 근처에 철광 있어. 나 혼자 캐기엔 많아.", "face": "normal"},
{"scene": "c3", "who": "hana", "text": "…노래 못해.", "face": "flustered"},
{"scene": "c3", "who": "hana", "text": "…기계가 후한 거야.", "face": "flustered"},
{"scene": "c3", "who": "hana", "text": "진해에서 친구가 놀러 와. 전에 살던 데. 나 여기 친구 있다고 했더니 보고 싶대.", "face": "happy"},
{"scene": "c3", "who": "hana", "text": "도윤도. 둘 다. …세라는 좀 시끄러워. 미리 사과할게.", "face": "happy"},
{"scene": "c3", "who": "sera", "text": "하나야아! 니 살 빠졌나? 밥은 묵고 다니나?", "face": "normal"},
{"scene": "c3", "who": "hana", "text": "세라. 역에서 소리 지르지 마.", "face": "pout"},
{"scene": "c3", "who": "sera", "text": "생각보다 평범하네.", "face": "disdain"},
{"scene": "c3", "who": "hana", "text": "세라야.", "face": "pout"},
{"scene": "c3", "who": "sera", "text": "칭찬이다, 칭찬. 하나가 평범한 애랑 친해진 게 처음이라 그렇지. 진해 있을 땐 나 말고 아무도 없었다 아이가.", "face": "normal"},
{"scene": "c3_arcade", "who": "sera", "text": "2위가 뭘 그리 당당하노.", "face": "disdain"},
{"scene": "c3_arcade", "who": "sera", "text": "봐라, 하나 웃는다. 진해 떠나고 처음 보는 거 아이가.", "face": "normal"},
{"scene": "c3_arcade", "who": "hana", "text": "…아니야. 여기서 많이 웃었어.", "face": "flustered"},
{"scene": "c3_arcade", "who": "hana", "text": "…그런가.", "face": "normal"},
{"scene": "c3_arcade", "who": "sera", "text": "…흐음.", "face": "disdain"},
{"scene": "c3_bingsu", "who": "sera", "text": "아직도 그거 묵나. 진해 있을 때도 맨날 그 조합이었다 아이가.", "face": "normal"},
{"scene": "c3_bingsu", "who": "hana", "text": "차가운 거랑 탄산이랑 같이 먹으면 머리가 띵해져. 그게 여름 같아서 좋아.", "face": "happy"},
{"scene": "c3_bingsu", "who": "hana", "text": "이사 가는 날은 늘 여름이었어. 기차 타기 전에 꼭 이거 먹었어.", "face": "normal"},
{"scene": "c3_bingsu", "who": "sera", "text": "…니 따라 시켰나? 하나야, 니 친구 착하네.", "face": "normal"},
{"scene": "c3_bingsu", "who": "hana", "text": "…맛없으면 남겨도 돼.", "face": "flustered"},
{"scene": "c3_bingsu", "who": "hana", "text": "하지 마.", "face": "pout"},
{"scene": "c3_bingsu", "who": "sera", "text": "관사 단지 벚꽃길에서 자전거 타다가 군악대 앞에 넘어졌다 아이가. 군악대가 연주를 멈췄다. 진해 역사상 처음으로.", "face": "normal"},
{"scene": "c3_bingsu", "who": "hana", "text": "…세라 너 돌아가.", "face": "pout"},
{"scene": "c3_bingsu", "who": "sera", "text": "그라고 중학교 졸업식 날, 나한테 편지 써 놓고 안 줬다. 이삿짐에서 나중에 나왔다 카더라.", "face": "normal"},
{"scene": "c3_bingsu", "who": "hana", "text": "세라!", "face": "flustered"},
{"scene": "c3_bingsu", "who": "hana", "text": "…화장실 다녀올게.", "face": "flustered"},
{"scene": "c3_bingsu", "who": "sera", "text": "너, 하나가 또 떠나면 어떡할 건데?", "face": "angry"},
{"scene": "c3_bingsu", "who": "sera", "text": "쟈는 정 붙은 데서 떠날 때가 제일 힘들다. 진해 떠날 때 기차에서 세 시간 내내 울었다 카더라. 그래서 처음부터 아무랑도 안", "face": "disdain"},
{"scene": "c3_bingsu", "who": "sera", "text": "근데 니랑은 친해졌다. 그기 좋은 긴지 나쁜 긴지 나는 모르겠다.", "face": "disdain"},
{"scene": "c3_sera", "who": "sera", "text": "…흥. 합격.", "face": "normal"},
{"scene": "c3_sera", "who": "sera", "text": "나도 아빠가 해군이라 맨날 이사 다닌다. 근데 나는 떠날 때 시끄럽게 울고, 연락도 시끄럽게 한다. 그래서 하나랑 아직 친구다", "face": "normal"},
{"scene": "c3_sera", "who": "sera", "text": "하나는 조용히 운다. 그라고 연락을 안 한다. 상대가 먼저 할 때까지. 그래서 다 끊긴다.", "face": "disdain"},
{"scene": "c3_sera", "who": "sera", "text": "…니가 시끄러운 쪽 해라.", "face": "normal"},
{"scene": "c3_think", "who": "sera", "text": "…솔직하네. 그것도 나쁘진 않다.", "face": "normal"},
{"scene": "c3_think", "who": "sera", "text": "근데 생각은 해 둬라. 그날은 꼭 온다. 해군 집은 늘 그렇다.", "face": "disdain"},
{"scene": "c3_bad", "who": "sera", "text": "…그래. 다들 그렇게 말하더라.", "face": "disdain"},
{"scene": "c3_night", "who": "sera", "text": "진해 군항제 불꽃이 더 크다.", "face": "normal"},
{"scene": "c3_night", "who": "hana", "text": "…여기 것도 예뻐.", "face": "happy"},
{"scene": "c3_night", "who": "sera", "text": "…니 진짜 여기 좋은가 보네.", "face": "normal"},
{"scene": "c3_night", "who": "sera", "text": "번호 찍어라. 쟈가 또 혼자 버틸라 카면 나한테 연락해라. 쟈는 그런 거 절대 먼저 말 안 한다.", "face": "normal"},
{"scene": "c3_night", "who": "sera", "text": "겨울에 또 온다. 그때까지 둘 다 사이좋게 지내라.", "face": "normal"},
{"scene": "i3", "who": "sera", "text": "(메시지) 하나야. 니 이번엔 진짜 친구 생겼네.", "face": "normal"},
{"scene": "i3", "who": "hana", "text": "(메시지) …응.", "face": "flustered"},
{"scene": "i3", "who": "sera", "text": "(메시지) 그라믄 이번엔 떠날 때 제대로 인사해라. 진해 때처럼 편지 써 놓고 안 주지 말고.", "face": "normal"},
{"scene": "i3", "who": "hana", "text": "(메시지) 아직 안 떠나.", "face": "pout"},
{"scene": "c4", "who": "hana", "text": "…괜찮아. 전에도 이런 적 있어. 몇 달 지나면 다들 질려.", "face": "normal"},
{"scene": "c4", "who": "hana", "text": "그리고 몇 달 지나면, 나 어차피 없을지도 모르고.", "face": "crying"},
{"scene": "c4", "who": "hana", "text": "(메시지) 응. 물리실 가는 길이었어. 3학년 교실 앞 지나야 물리실 가.", "face": "normal"},
{"scene": "c4", "who": "hana", "text": "(메시지) …알아줘서 고마워. 그거면 돼.", "face": "normal"},
{"scene": "c4_absent", "who": "father", "text": "…누구지.", "face": "normal"},
{"scene": "c4_absent", "who": "father", "text": "아. 진자.", "face": "normal"},
{"scene": "c4_absent", "who": "father", "text": "진자 그래프 같이 그렸다는 친구. 하나가 말하더군.", "face": "normal"},
{"scene": "c4_absent", "who": "father", "text": "그 시끄러운 노래 아는 친구. 하나가 말하더군.", "face": "normal"},
{"scene": "c4_absent", "who": "father", "text": "…하나는 아픈 게 아니다. 학교 가기 싫다고 한 건 처음이라, 하루 쉬게 했다.", "face": "normal"},
{"scene": "c4_absent", "who": "father", "text": "내가 이사를 너무 많이 시켰지. 저 아이는 한 번도 불평한 적이 없다. 그래서 더 모르겠다.", "face": "normal"},
{"scene": "c4_absent", "who": "father", "text": "…그래. 고맙다.", "face": "relief"},
{"scene": "c4_absent", "who": "father", "text": "전하겠다.", "face": "normal"},
{"scene": "c4_hall", "who": "hana", "text": "…그런 적 없어.", "face": "flustered"},
{"scene": "c4_defend", "who": "hana", "text": "…왜 그랬어. 너까지 찍혀.", "face": "crying"},
{"scene": "c4_defend", "who": "hana", "text": "나, 여기가 여덟 번째 학교야.", "face": "crying"},
{"scene": "c4_defend", "who": "hana", "text": "처음엔 열심히 친해졌어. 초등학교 땐 전학 첫날 반 애들 이름 다 외워 갔어. 그러다 떠날 때마다 너무 힘들어서, 중학교 때부", "face": "crying"},
{"scene": "c4_defend", "who": "hana", "text": "2년만 버티면 되니까. 그 2년 동안 아무것도 안 남기면, 떠날 때 안 아프니까.", "face": "crying"},
{"scene": "c4_defend", "who": "hana", "text": "근데 이번엔 연습한 게 잘 안 돼.", "face": "crying"},
{"scene": "c4_defend", "who": "hana", "text": "…월요일에 아빠한테 들었어. 네가 온 거.", "face": "normal"},
{"scene": "c4_defend", "who": "hana", "text": "…오늘은 좀, 고마웠어.", "face": "happy"},
{"scene": "c5", "who": "hana", "text": "…진자 여러 개 길이를 다르게 해서 동시에 흔들면, 파도처럼 보이는 거 있잖아요. 그거 해 보고 싶어요.", "face": "focused"},
{"scene": "c5_wave", "who": "hana", "text": "…기억하네, 첫 실험.", "face": "happy"},
{"scene": "c5_wave", "who": "hana", "text": "리듬게임 생각해. 노트 15개가 각자 다른 BPM으로 떨어지는데, 어느 순간 다 같이 맞아.", "face": "focused"},
{"scene": "c5_wave", "who": "hana", "text": "…주기 계산을 틀렸어. 내가. 공기 저항을 빼먹었어. 그리고 실 무게도.", "face": "crying"},
{"scene": "c5_wave", "who": "hana", "text": "역시 안 하는 게 나았나. 뭘 남기려고 하면, 꼭 이렇게 돼.", "face": "crying"},
{"scene": "c5_wave", "who": "hana", "text": "…그 말 기억하고 있었어?", "face": "flustered"},
{"scene": "c5_wave", "who": "hana", "text": "…응. 다시 재자. 처음부터.", "face": "focused"},
{"scene": "c5_wave", "who": "hana", "text": "…같이. 응.", "face": "happy"},
{"scene": "c5_wave", "who": "hana", "text": "…돌아왔다.", "face": "happy"},
{"scene": "c5_wave", "who": "hana", "text": "…건배.", "face": "happy"},
{"scene": "c5_wave", "who": "hana", "text": "처음엔 다 같이 흔들리다가, 어긋났다가, 기다리면 다시 맞춰져. 나 이거 좋아.", "face": "happy"},
{"scene": "c5_yerin", "who": "hana", "text": "…길이가 조금씩 달라서 주기가 어긋나는 거야. 처음엔 다 같이 흔들리다가, 점점 어긋나면서 파도가 되고, 시간이 지나면 다시 ", "face": "focused"},
{"scene": "c5_yerin", "who": "hana", "text": "응. 기다리면.", "face": "normal"},
{"scene": "c5_yerin", "who": "hana", "text": "괜찮아.", "face": "normal"},
{"scene": "c5_yerin", "who": "hana", "text": "…그럼, 사과 받을게.", "face": "happy"},
{"scene": "c5_end", "who": "hana", "text": "3학년 때도 같은 반이면 좋겠다.", "face": "happy"},
{"scene": "c5_end", "who": "hana", "text": "…응. 30개로 하자.", "face": "happy"},
{"scene": "c5_end", "who": "hana", "text": "(채팅) 트리 꼭대기 별, 내가 달았어.", "face": "happy"},
{"scene": "c5_end", "who": "hana", "text": "(채팅) 별 다는 거, 처음이야. 매년 이사 준비하느라 트리 안 했어.", "face": "happy"},
{"scene": "i5", "who": "father", "text": "하나. 할 말이 있다.", "face": "normal"},
{"scene": "i5", "who": "father", "text": "2월 말. 동해다. 이번이 마지막 함상 근무다. 그 다음엔 육상 근무라, 오래 있을 수 있다.", "face": "normal"},
{"scene": "i5", "who": "father", "text": "…미안하다. 이번엔 1년도 못 채웠다.", "face": "normal"},
{"scene": "i5", "who": "hana", "text": "…괜찮아. 익숙해.", "face": "crying"},
{"scene": "c6", "who": "hana", "text": "새로 샀어. 그거 너 해.", "face": "normal"},
{"scene": "c6", "who": "hana", "text": "…새 학기 준비. 3학년 되니까.", "face": "normal"},
{"scene": "c6_sera", "who": "sera", "text": "(메시지) 하나 또 이사 간다. 다음 주 토요일 아침 7시 40분 기차. 동해. 너한테 말 안 했제? 그럴 줄 알았다.", "face": "normal"},
{"scene": "c6_sera", "who": "sera", "text": "(메시지) 겨울에 놀러 가기로 했는데 그것도 취소됐다. 쟈 지금 동네 공원에 있을 끼다. 생각 많을 때 그네 타는 버릇 있다.", "face": "normal"},
{"scene": "c6_sera", "who": "sera", "text": "(메시지) 니가 시끄러운 쪽 하기로 했제. 가라.", "face": "normal"},
{"scene": "c6_sera", "who": "hana", "text": "…세라지. 걔 진짜.", "face": "pout"},
{"scene": "c6_sera", "who": "hana", "text": "말 안 하려고 했어. 말하면 남은 날이 전부 \"떠나는 애\"의 날이 되니까. 마지막까지 그냥, 같은 반이고 싶었어.", "face": "crying"},
{"scene": "c6_sera", "who": "hana", "text": "…그리고 말하면 가기 싫어지니까. 가기 싫다고 생각하는 것도 연습 안 해 봤거든.", "face": "crying"},
{"scene": "c6_sera", "who": "hana", "text": "…응. 미안. 그리고 고마워.", "face": "crying"},
{"scene": "c6_sera", "who": "hana", "text": "아빠가 이번이 마지막 함상 근무래. 다음엔 오래 있을 수 있대. 대학 갈 때쯤엔 이사 안 다녀도 된대.", "face": "normal"},
{"scene": "c6_sera", "who": "hana", "text": "…그때쯤이면 내가 어디 살지, 처음으로 내가 고를 수 있어.", "face": "happy"},
{"scene": "c6_sera", "who": "hana", "text": "…친구니까 말 못 한 거야. 모르겠어? 몰라도 돼.", "face": "pout"},
{"scene": "c6_last", "who": "hana", "text": "너. 원래 너였잖아.", "face": "normal"},
{"scene": "c6_last", "who": "hana", "text": "…고마워, 예린아.", "face": "happy"},
{"scene": "c6_last", "who": "hana", "text": "…네. 선생님도요.", "face": "happy"},
{"scene": "c6_server", "who": "hana", "text": "(채팅) 지붕, 다 지었어. 화로에 석탄 채워 놨어. 겨울 동안 써.", "face": "normal"},
{"scene": "c6_server", "who": "hana", "text": "(채팅) 표지판은 \"잠깐 비움\"으로 둘게. \"임시\"보다는 낫잖아.", "face": "happy"},
{"scene": "endA", "who": "hana", "text": "…왜 왔어. 안 오면 그냥 갈 수 있었는데. 연습한 대로.", "face": "crying"},
{"scene": "endA", "who": "hana", "text": "…서버는 그대로 둘게. 들어오면 화로 써. 석탄 다 떨어지면 말해.", "face": "crying"},
{"scene": "endA", "who": "hana", "text": "이어폰, 한쪽 줄게. 다음에 만나면 돌려줘. 그때 2절부터 같이 듣자.", "face": "crying"},
{"scene": "endA", "who": "hana", "text": "…이번엔 처음으로, 가기 싫다고 생각했어. 연습 안 한 거라 어떻게 해야 할지 모르겠어.", "face": "crying"},
{"scene": "endA", "who": "hana", "text": "…2년 뒤에. 대학에서. 꼭 다시 만나자.", "face": "happy"},
{"scene": "endA", "who": "hana", "text": "아빠가 그러는데, 그때쯤이면 내가 어디 살지 내가 고를 수 있대. 그러니까 이번 약속은, 지킬 수 있는 약속이야.", "face": "happy"},
{"scene": "endA", "who": "father", "text": "이 아이가 이사 가기 싫다고 한 건 처음이다. 아비로서는 미안한 일인데, 이상하게 고맙다.", "face": "relief"},
{"scene": "endB", "who": "hana", "text": "…연락할게.", "face": "crying"},
{"scene": "endB", "who": "hana", "text": "…짧았는데, 제일 길었어.", "face": "crying"}
]
